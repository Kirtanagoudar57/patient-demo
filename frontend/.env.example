# Copy this file to `.env` and adjust if needed. Only variables prefixed with
# VITE_ are exposed to the browser, so never put secrets in this file.

# --- Option A (default, recommended for local development) ---
# The app calls /api/... and the Vite dev server forwards those requests to
# FastAPI. This works without adding CORS to the backend.
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:8000

# --- Option B: call FastAPI directly from the browser ---
# Requires CORSMiddleware in the backend (see README, "CORS").
# VITE_API_BASE_URL=http://127.0.0.1:8000
