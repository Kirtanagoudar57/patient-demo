# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patient_db

# Optional: Full SQLAlchemy Database URL (overrides the individual DB_* settings above)
# DATABASE_URL=postgresql+psycopg2://postgres:replace_with_your_database_password@localhost:5432/patient_db
